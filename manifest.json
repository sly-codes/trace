{
  "manifest_version": 3,
  "name": "Trace",
  "version": "1.0.0",
  "description": "Inspect the web, one element at a time.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Trace: inspect an element",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "commands": {
    "start-inspecting": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Start inspecting the current page"
    }
  }
}
